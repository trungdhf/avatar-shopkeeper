VITE_STORE_ADDRESS=
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Development only: swap the looping idle clip for a local .vrma while recording.
# Ignored by production builds, because the BOOTH pack must not be published.
# VITE_IDLE_MOTION=/dev-motions/VRMA_01.vrma

# Development only: chain local .vrma files as a looping idle, for recording.
# Ignored by production builds, and /dev-motions exists only under vite dev.
# VITE_IDLE_CHAIN=VRMA_01.vrma,VRMA_03.vrma,VRMA_04.vrma,VRMA_05.vrma,VRMA_06.vrma

# Intercepta address screening. Server side only: no VITE_ prefix, because Vite
# inlines the value of every VITE_ variable into the published bundle. Set the
# same name in the hosting provider so api/screen.ts can read it. Without it the
# checkout simply reports screening as not configured.
# INTERCEPTA_API_KEY=
